      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "requests_kind": {
          "name": "requests_kind",
          "value": "\"requests\".\"kind\" IN ('vacation', 'sick')"
        },
        "requests_state": {
          "name": "requests_state",
          "value": "\"requests\".\"state\" IN ('pending', 'approved', 'rejected', 'cancelled')"
        },
        "requests_days": {
          "name": "requests_days",
          "value": "date(\"requests\".\"first_day\") IS \"requests\".\"first_day\" AND date(\"requests\".\"last_day\") IS \"requests\".\"last_day\" AND length(\"requests\".\"first_day\") = 10 AND length(\"requests\".\"last_day\") = 10 AND \"requests\".\"first_day\" <= \"requests\".\"last_day\" AND substr(\"requests\".\"first_day\", 1, 4) = substr(\"requests\".\"last_day\", 1, 4)"
        },
        "requests_counted": {
          "name": "requests_counted",
          "value": "\"requests\".\"counted_days\" >= 1"
        },
        "requests_note": {
          "name": "requests_note",
          "value": "\"requests\".\"rejection_note\" IS NULL OR (length(\"requests\".\"rejection_note\") BETWEEN 1 AND 200)"
        },
        "requests_cancel_from": {
          "name": "requests_cancel_from",
          "value": "\"requests\".\"cancel_from\" IS NULL OR (date(\"requests\".\"cancel_from\") IS \"requests\".\"cancel_from\" AND length(\"requests\".\"cancel_from\") = 10 AND \"requests\".\"cancel_from\" > \"requests\".\"first_day\" AND \"requests\".\"cancel_from\" <= \"requests\".\"last_day\" AND \"requests\".\"state\" = 'approved' AND strftime('%w', \"requests\".\"cancel_from\") NOT IN ('0', '6'))"
        }
      }
